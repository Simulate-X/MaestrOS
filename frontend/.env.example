# MaestrOS Dashboard — Ortam Değişkenleri Şablonu
#
# Kullanım:
#   cp .env.example .env
#   Sonra: npm run dev

# ── Mod ───────────────────────────────────────────────────────────────────────
# true  → Sahte veri (backend gerekmez, demo/test için)
# false → Gerçek backend'e bağlan
VITE_USE_MOCK=false

# ── Backend URL ───────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
