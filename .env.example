# MaestrOS — Ortam Değişkenleri Şablonu
#
# Kullanım:
#   cp .env.example .env
#   Sonra .env dosyasını kendi değerlerinle doldur
#
# ÖNEMLİ: .env dosyası .gitignore'da — GitHub'a KESİNLİKLE gitmesin!

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Docker Compose kullanıyorsan bu değer olduğu gibi çalışır
DATABASE_URL=postgresql+asyncpg://maestros:maestros@db:5432/maestros

# ── Ollama (lokal AI modelleri) ────────────────────────────────────────────────
# Docker içinden erişim için:
OLLAMA_BASE_URL=http://ollama:11434
# Lokal geliştirme için (Docker dışı):
# OLLAMA_BASE_URL=http://localhost:11434

# ── Zamanlayıcı ayarları ─────────────────────────────────────────────────────
# Kaç saniyede bir aktif ajanları kontrol eder
SCHEDULER_TICK_INTERVAL=5
# Aynı anda kaç ajan çalışabilir
SCHEDULER_MAX_CONCURRENT=4
# Kaç saniye sonra kilitli ticket "orphan" sayılır
LEASE_TIMEOUT_SECONDS=600

# ── Bulut AI API Key'leri (isteğe bağlı) ─────────────────────────────────────
# Anthropic (claude-haiku, claude-sonnet kullanmak için)
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-BURAYA_KENDI_KEYINI_YAZ

# OpenRouter (yüzlerce modele tek key ile erişim: llama, gemini, gpt-4o…)
# https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-v1-BURAYA_KENDI_KEYINI_YAZ

# NOT: Sadece Ollama kullanıyorsan bu key'ler boş bırakılabilir.
# Ajan oluştururken provider="ollama" seçersen hiç API key gerekmez.
